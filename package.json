{
    "name": "strauss",
    "version": "1.0.0",
    "description": "Strauss Network Simulator",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder",
        "dist:win": "electron-builder --win",
        "dist:linux": "electron-builder --linux",
        "dist:mac": "electron-builder --mac",
        "pack": "electron-builder --dir"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "js-yaml": "^4.2.0"
    },
    "devDependencies": {
        "electron": "^44.1.1",
        "electron-builder": "^26.15.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JohnWhite-CodeSpace/Strauss.git"
    },
    "bugs": {
        "url": "https://github.com/JohnWhite-CodeSpace/Strauss/issues"
    },
    "homepage": "https://github.com/JohnWhite-CodeSpace/Strauss#readme",
    "build": {
        "appId": "com.johnwhite.strauss",
        "productName": "Strauss Network Simulator",
        "directories": {
            "output": "release"
        },
        "files": [
            "electron/**/*",
            "StraussModule/**/*",
            "styles/**/*",
            "index.html",
            "main.js",
            "package.json"
        ],
        "win": {
            "icon": "build/icon.ico",
            "target": [
                "nsis"
            ],
            "extraResources": [
                {
                    "from": "res/presentation.pdf",
                    "to": "presentation.pdf"
                },
                {
                    "from": "backends/win/StraussBackend-windows",
                    "to": "backend"
                },
                {
                    "from": "configs",
                    "to": "configs"
                }
            ]
        },
        "linux": {
            "icon": "build/icon.png",
            "target": [
                "AppImage"
            ],
            "extraResources": [
                {
                    "from": "res/presentation.pdf",
                    "to": "presentation.pdf"
                },
                {
                    "from": "backends/linux/StraussBackend-linux",
                    "to": "backend"
                },
                {
                    "from": "configs",
                    "to": "configs"
                }
            ]
        },
        "mac": {
            "icon": "build/icon.icns",
            "target": [
                "dmg"
            ],
            "extraResources": [
                {
                    "from": "res/presentation.pdf",
                    "to": "presentation.pdf"
                },
                {
                    "from": "backends/mac/StraussBackend-macos",
                    "to": "backend"
                },
                {
                    "from": "configs",
                    "to": "configs"
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    }
}